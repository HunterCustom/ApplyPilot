<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for Windows Task Scheduler (import manually; see DEPLOYMENT.md "Scheduling").
  Replace REPO_DIR and DATA_DIR before importing. Runs only when the user is logged on, never elevated,
  never overlaps (IgnoreNew + the applypilot lock), stops after 5 hours. Preparation only: no submissions.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>ApplyPilot daily preparation run (discover to review queue). Never submits applications.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-12-01T07:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <ExecutionTimeLimit>PT5H</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File "REPO_DIR\scripts\run_daily.ps1" -DataDir "DATA_DIR"</Arguments>
      <WorkingDirectory>REPO_DIR</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
